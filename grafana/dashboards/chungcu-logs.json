{
 "uid": "cc-logs",
 "title": "Chung cu - Log tap trung (Loki)",
 "tags": [
  "chungcu",
  "logs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "logs",
   "title": "Log ung dung (app)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"app\"}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "logs",
   "title": "Log Nginx - loi 4xx/5xx",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"nginx\"} | json | status >= 400",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Request Nginx theo ma trang thai",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (count_over_time({service=\"nginx\"} | json [1m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Dang nhap that bai (app)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({service=\"app\"} | json | msg=\"login_failed\" [1m]))",
     "legendFormat": "login_failed",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Log PostgreSQL - ERROR/FATAL",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"db\"} |~ \"(?i)error|fatal\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}