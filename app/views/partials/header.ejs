<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Chung cư</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<% if (user) { %>
<header class="top">
  <a class="brand" href="/">🏢 Quản lý Chung cư</a>
  <nav>
    <% menu.forEach(function(m){ %><a href="/<%= m.key %>"><%= m.title %></a><% }) %>
  </nav>
  <form method="post" action="/logout" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <span class="who"><%= user %></span>
    <button class="btn small">Đăng xuất</button>
  </form>
</header>
<% } %>
<main>
