# Sao chep thanh .env roi doi gia tri (hoac chay ./scripts/gen-env.sh de tu sinh mat khau)
COMPOSE_FILE=docker-compose.yml

# --- PostgreSQL ---
DB_NAME=chungcu
POSTGRES_SUPER_USER=pgadmin_root
POSTGRES_SUPER_PASSWORD=CHANGE_ME
APP_DB_USER=chungcu_app
APP_DB_PASSWORD=CHANGE_ME
EXPORTER_DB_PASSWORD=CHANGE_ME

# --- Ung dung web ---
SESSION_SECRET=CHANGE_ME
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@chungcu.vn
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Cac cong quan tri (pgAdmin, Grafana, Prometheus) chi mo tren dia chi nay.
# Dung 127.0.0.1 (an toan) hoac 0.0.0.0 neu can truy cap tu may khac khi demo.
ADMIN_BIND=127.0.0.1
